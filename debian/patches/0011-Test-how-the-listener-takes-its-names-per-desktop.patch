+/* Unity desktop, another connection owns org.freedesktop.ScreenSaver:
+ * light-locker starts with org.gnome.ScreenSaver, the other keeps its name */
+static void
+test_unity_desktop_freedesktop_name_taken (GSListener *listener)
+{
+        GDBusConnection *test = new_connection ();
+        GDBusConnection *other = new_connection ();
+        GError *error = NULL;
+
+        take_name (other, SS_NAME);
+        g_assert_true (gs_listener_acquire (listener, &error));
+        g_assert_no_error (error);
+        assert_listener_owns (test, other, GSS_NAME);
+        assert_owner (test, SS_NAME, other);
+        assert_one_locked_hint_false ();
+        close_connection (other);
+        close_connection (test);
+}
+
+/* other desktops: light-locker stops as before */
+static void
+test_other_desktop_freedesktop_name_taken (GSListener *listener)
+{
+        GDBusConnection *test = new_connection ();
+        GDBusConnection *other = new_connection ();
+        GError *error = NULL;
+
+        take_name (other, SS_NAME);
+        g_assert_false (gs_listener_acquire (listener, &error));
+        g_assert_nonnull (error);
+        g_clear_error (&error);
+        assert_owner (test, SS_NAME, other);
+        assert_owner (test, GSS_NAME, NULL);
+        assert_no_locked_hint ();
+        close_connection (other);
+        close_connection (test);
+}
+
+/* Unity desktop, one other connection owns both names, as a running
+ * light-locker does: light-locker stops, nothing changes */
+static void
+test_unity_desktop_gnome_name_taken (GSListener *listener)
+{
+        GDBusConnection *test = new_connection ();
+        GDBusConnection *other = new_connection ();
+        GError *error = NULL;
+
+        take_name (other, SS_NAME);
+        take_name (other, GSS_NAME);
+        watch_owner_changes (test, SS_NAME);
+        watch_owner_changes (test, GSS_NAME);
+        g_assert_false (gs_listener_acquire (listener, &error));
+        g_assert_nonnull (error);
+        g_clear_error (&error);
+        assert_no_locked_hint ();
+        g_assert_cmpuint (owner_changes, ==, 0);
+        assert_owner (test, SS_NAME, other);
+        assert_owner (test, GSS_NAME, other);
+        close_connection (other);
+        close_connection (test);
+}
+
+/* Unity desktop, both names free: light-locker owns both */
+static void
+test_unity_desktop_freedesktop_free (GSListener *listener)
+{
+        GDBusConnection *test = new_connection ();
+        GError *error = NULL;
+
+        g_assert_true (gs_listener_acquire (listener, &error));
+        g_assert_no_error (error);
+        assert_listener_owns (test, NULL, GSS_NAME);
+        assert_listener_owns (test, NULL, SS_NAME);
+        assert_one_locked_hint_false ();
+        close_connection (test);
+}
+
+/* Unity desktop, the request for org.freedesktop.ScreenSaver fails with an
+ * error: light-locker starts with org.gnome.ScreenSaver, no error */
+static void
+test_unity_desktop_freedesktop_request_error (GSListener *listener)
