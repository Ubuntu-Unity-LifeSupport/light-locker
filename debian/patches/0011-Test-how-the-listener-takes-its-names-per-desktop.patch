+        assert_owner (test, SS_NAME, NULL);
+        assert_one_locked_hint_false ();
+        close_connection (test);
+}
+
+/* Unity desktop, the request for org.gnome.ScreenSaver fails with an
+ * error: light-locker stops before taking any name or writing the hint */
+static void
+test_unity_desktop_gnome_request_error (GSListener *listener)
+{
+        GDBusConnection *test = new_connection ();
+        GError *error = NULL;
+
+        failing_name = GSS_NAME;
+        g_assert_false (gs_listener_acquire (listener, &error));
+        g_assert_nonnull (error);
+        g_clear_error (&error);
+        assert_owner (test, SS_NAME, NULL);
+        assert_owner (test, GSS_NAME, NULL);
+        assert_no_locked_hint ();
+        close_connection (test);
+}
