+static char *
+name_owner (GDBusConnection *connection, const char *name)
+{
+        GVariant *reply;
+        char *owner = NULL;
+
+        reply = g_dbus_connection_call_sync (connection, "org.freedesktop.DBus", "/org/freedesktop/DBus",
+                                             "org.freedesktop.DBus", "GetNameOwner",
+                                             g_variant_new ("(s)", name), G_VARIANT_TYPE ("(s)"),
+                                             G_DBUS_CALL_FLAGS_NONE, WAIT_MS, NULL, NULL);
+        if (reply != NULL) {
+                g_variant_get (reply, "(s)", &owner);
+                g_variant_unref (reply);
+        }
+        return owner;
+}
+
+static void
+take_name (GDBusConnection *connection, const char *name)
+{
+        GVariant *reply;
+        guint result = 0;
+
+        reply = g_dbus_connection_call_sync (connection, "org.freedesktop.DBus", "/org/freedesktop/DBus",
+                                             "org.freedesktop.DBus", "RequestName",
+                                             g_variant_new ("(su)", name, DBUS_NAME_FLAG_DO_NOT_QUEUE),
+                                             G_VARIANT_TYPE ("(u)"), G_DBUS_CALL_FLAGS_NONE, WAIT_MS,
+                                             NULL, NULL);
+        g_assert_nonnull (reply);
+        g_variant_get (reply, "(u)", &result);
+        g_variant_unref (reply);
+        g_assert_cmpuint (result, ==, DBUS_REQUEST_NAME_REPLY_PRIMARY_OWNER);
+}
+
+/* light-locker owns the name: an owner, and none of the test's connections */
+static void
+assert_listener_owns (GDBusConnection *test, GDBusConnection *other, const char *name)
+{
+        char *owner = name_owner (test, name);
+
+        g_assert_nonnull (owner);
+        g_assert_cmpstr (owner, !=, g_dbus_connection_get_unique_name (test));
+        if (other != NULL)
+                g_assert_cmpstr (owner, !=, g_dbus_connection_get_unique_name (other));
+        g_free (owner);
+}
+
+static void
+assert_owner (GDBusConnection *test, const char *name, GDBusConnection *expected)
+{
+        char *owner = name_owner (test, name);
+
+        g_assert_cmpstr (owner, ==, expected != NULL ? g_dbus_connection_get_unique_name (expected) : NULL);
+        g_free (owner);
+}
+
+static gboolean
+locked_hint_sent (gpointer data)
+{
+        return g_atomic_int_get (&locked_hint_calls) > 0;
+}
+
+/* exactly one SetLockedHint(false) */
+static void
+assert_one_locked_hint_false (void)
+{
+        g_assert_true (wait_until (locked_hint_sent, NULL));
+        spin (300);
+        g_assert_cmpint (g_atomic_int_get (&locked_hint_calls), ==, 1);
+        g_assert_cmpint (g_atomic_int_get (&locked_hint_true_calls), ==, 0);
+}
+
+static void
+assert_no_locked_hint (void)
+{
+        spin (300);
+        g_assert_cmpint (g_atomic_int_get (&locked_hint_calls), ==, 0);
+}
+
+static guint owner_changes;
+
+static void
+on_name_owner_changed (GDBusConnection *connection, const char *sender, const char *path,
+                       const char *iface, const char *signal, GVariant *parameters, gpointer data)
+{
+        owner_changes++;
+}
+
+static void
+watch_owner_changes (GDBusConnection *watcher, const char *name)
+{
+        g_dbus_connection_signal_subscribe (watcher, "org.freedesktop.DBus", "org.freedesktop.DBus",
+                                            "NameOwnerChanged", "/org/freedesktop/DBus", name,
+                                            G_DBUS_SIGNAL_FLAGS_NONE, on_name_owner_changed,
+                                            NULL, NULL);
+        /* a round trip: the bus has the match before anything else happens */
+        g_free (name_owner (watcher, "org.freedesktop.DBus"));
+}
