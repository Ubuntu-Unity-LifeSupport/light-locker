diff --git a/src/gs-session-inhibit.c b/src/gs-session-inhibit.c
new file mode 100644
index 0000000..8f2391d
--- /dev/null
+++ b/src/gs-session-inhibit.c
@@ -0,0 +1,256 @@
+/* -*- Mode: C; tab-width: 8; indent-tabs-mode: nil; c-basic-offset: 8 -*-
+ *
+ * Forward org.freedesktop.ScreenSaver inhibitors to the session manager
+ *
+ * Each inhibitor an application takes through org.freedesktop.ScreenSaver
+ * is passed on as an idle inhibitor of org.gnome.SessionManager (as
+ * gnome-screensaver 2.x did), so that the session does not go idle while
+ * the application holds it, and released with it.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "config.h"
+
+#include <string.h>
+
+#include "gs-session-inhibit.h"
+#include "gs-debug.h"
+
+#define SM_NAME      "org.gnome.SessionManager"
+#define SM_PATH      "/org/gnome/SessionManager"
+#define SM_INTERFACE "org.gnome.SessionManager"
+#define SM_FLAG_IDLE 8
+
+#define DEFAULT_REASON "Inhibited through org.freedesktop.ScreenSaver"
+
+struct GSSessionInhibit {
+        GDBusConnection *connection;
+        GCancellable    *cancellable;
+        guint            sm_watch_id;
+        GHashTable      *entries;
+};
+
+typedef struct {
+        guint32   sm_cookie;
+        char     *sm_owner;
+        gboolean  pending;
+        gboolean  released;
+} Entry;
+
+typedef struct {
+        GSSessionInhibit *inhibit;
+        guint32           cookie;
+} Call;
+
+static void
+entry_free (gpointer data)
+{
+        Entry *entry = data;
+
+        g_free (entry->sm_owner);
+        g_free (entry);
+}
+
+static void
+send_uninhibit (GSSessionInhibit *inhibit,
+                Entry            *entry)
+{
+        if (entry->sm_cookie == 0 || entry->sm_owner == NULL)
+                return;
+
+        /* to the session manager that gave the cookie, by its unique name:
+         * session manager cookies are not tied to the caller, so a stale
+         * one must not reach a new owner of the well-known name */
+        g_dbus_connection_call (inhibit->connection,
+                                entry->sm_owner,
+                                SM_PATH,
+                                SM_INTERFACE,
+                                "Uninhibit",
+                                g_variant_new ("(u)", entry->sm_cookie),
+                                NULL,
+                                G_DBUS_CALL_FLAGS_NO_AUTO_START,
+                                -1,
+                                NULL, NULL, NULL);
+}
+
+static void
+inhibit_reply (GObject      *source,
+               GAsyncResult *result,
+               gpointer      user_data)
+{
+        Call             *call = user_data;
+        GSSessionInhibit *inhibit = call->inhibit;
+        GDBusMessage     *reply;
+        GError           *error = NULL;
+        Entry            *entry;
+
+        reply = g_dbus_connection_send_message_with_reply_finish (G_DBUS_CONNECTION (source),
+                                                                  result, &error);
+        if (reply == NULL && g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) {
+                g_error_free (error);
+                g_free (call);
+                return;
+        }
+
+        entry = g_hash_table_lookup (inhibit->entries, &call->cookie);
+        g_assert (entry != NULL && entry->pending);
+        entry->pending = FALSE;
+
+        if (reply != NULL && !g_dbus_message_to_gerror (reply, &error)) {
+                g_variant_get (g_dbus_message_get_body (reply), "(u)", &entry->sm_cookie);
+                entry->sm_owner = g_strdup (g_dbus_message_get_sender (reply));
+                gs_debug ("Session manager inhibitor %u for ScreenSaver cookie %u",
+                          entry->sm_cookie, call->cookie);
+        } else {
+                gs_debug ("Session manager Inhibit failed: %s", error->message);
+                g_clear_error (&error);
+                entry->released = TRUE;
+        }
+
+        if (entry->released) {
+                send_uninhibit (inhibit, entry);
+                g_hash_table_remove (inhibit->entries, &call->cookie);
+        }
+
+        g_clear_object (&reply);
+        g_free (call);
+}
+
+/* The session manager went away or changed owner: its inhibitors went with
+ * it, and a new one is not asked again (a new session manager is a new
+ * session). */
+static void
+sm_vanished (GDBusConnection *connection,
+             const char      *name,
+             gpointer         user_data)
+{
+        GSSessionInhibit *inhibit = user_data;
+        GHashTableIter    iter;
+        Entry            *entry;
+
+        g_hash_table_iter_init (&iter, inhibit->entries);
+        while (g_hash_table_iter_next (&iter, NULL, (gpointer *) &entry)) {
+                if (entry->pending)
+                        continue;
+                entry->sm_cookie = 0;
+                g_clear_pointer (&entry->sm_owner, g_free);
+        }
+}
+
+GSSessionInhibit *
+gs_session_inhibit_new (GDBusConnection *connection)
+{
+        GSSessionInhibit *inhibit;
+
+        g_return_val_if_fail (G_IS_DBUS_CONNECTION (connection), NULL);
+
+        inhibit = g_new0 (GSSessionInhibit, 1);
+        inhibit->connection = g_object_ref (connection);
+        inhibit->cancellable = g_cancellable_new ();
+        inhibit->entries = g_hash_table_new_full (g_int_hash, g_int_equal, g_free, entry_free);
+        inhibit->sm_watch_id = g_bus_watch_name_on_connection (connection,
+                                                               SM_NAME,
+                                                               G_BUS_NAME_WATCHER_FLAGS_NONE,
+                                                               NULL,
+                                                               sm_vanished,
+                                                               inhibit,
+                                                               NULL);
+        return inhibit;
+}
+
+void
+gs_session_inhibit_free (GSSessionInhibit *inhibit)
+{
+        if (inhibit == NULL)
+                return;
+
+        g_cancellable_cancel (inhibit->cancellable);
+        g_bus_unwatch_name (inhibit->sm_watch_id);
+        g_hash_table_destroy (inhibit->entries);
+        g_object_unref (inhibit->cancellable);
+        g_object_unref (inhibit->connection);
+        g_free (inhibit);
+}
+
+gboolean
+gs_session_inhibit_has (GSSessionInhibit *inhibit,
+                        guint32           cookie)
+{
+        return inhibit != NULL && g_hash_table_contains (inhibit->entries, &cookie);
+}
+
+void
+gs_session_inhibit_add (GSSessionInhibit *inhibit,
+                        guint32           cookie,
+                        const char       *application,
+                        const char       *reason,
+                        const char       *caller)
+{
+        GDBusMessage *message;
+        guint32      *key;
+        Entry        *entry;
+        Call         *call;
+
+        if (inhibit == NULL)
+                return;
+
+        g_return_if_fail (!g_hash_table_contains (inhibit->entries, &cookie));
+
+        /* the session manager refuses empty strings */
+        if (application == NULL || *application == '\0')
+                application = caller;
+        if (reason == NULL || *reason == '\0')
+                reason = DEFAULT_REASON;
+
+        message = g_dbus_message_new_method_call (SM_NAME, SM_PATH, SM_INTERFACE, "Inhibit");
+        g_dbus_message_set_body (message, g_variant_new ("(susu)", application, 0, reason,
+                                                         SM_FLAG_IDLE));
+        g_dbus_message_set_flags (message, G_DBUS_MESSAGE_FLAGS_NO_AUTO_START);
+
+        key = g_new (guint32, 1);
+        *key = cookie;
+        entry = g_new0 (Entry, 1);
+        entry->pending = TRUE;
+        g_hash_table_insert (inhibit->entries, key, entry);
+
+        call = g_new (Call, 1);
+        call->inhibit = inhibit;
+        call->cookie = cookie;
+        g_dbus_connection_send_message_with_reply (inhibit->connection,
+                                                   message,
+                                                   G_DBUS_SEND_MESSAGE_FLAGS_NONE,
+                                                   -1,
+                                                   NULL,
+                                                   inhibit->cancellable,
+                                                   inhibit_reply,
+                                                   call);
+        g_object_unref (message);
+}
+
+void
+gs_session_inhibit_remove (GSSessionInhibit *inhibit,
+                           guint32           cookie)
+{
+        Entry *entry;
+
+        if (inhibit == NULL)
+                return;
+
+        entry = g_hash_table_lookup (inhibit->entries, &cookie);
+        if (entry == NULL)
+                return;
+
+        /* released before the session manager answered: Uninhibit when the
+         * answer comes */
+        if (entry->pending) {
+                entry->released = TRUE;
+                return;
+        }
+
+        send_uninhibit (inhibit, entry);
+        g_hash_table_remove (inhibit->entries, &cookie);
+}
