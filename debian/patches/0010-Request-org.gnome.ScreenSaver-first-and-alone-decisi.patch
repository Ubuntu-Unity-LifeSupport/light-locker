diff --git a/src/gs-lock-after.c b/src/gs-lock-after.c
index 511736c..c3f93a5 100644
--- a/src/gs-lock-after.c
+++ b/src/gs-lock-after.c
@@ -12,22 +12,28 @@
 
 #include "gs-lock-after.h"
 
-/* In a Unity session Unity asks for the blank and decides whether and when
- * to lock, from the desktop's screensaver settings, so no lock timer of our
- * own is armed.  The setting itself is left as it is. */
-guint
-gs_lock_after_for_desktop (guint       configured,
-                           const char *current_desktop)
+gboolean
+gs_desktop_is_unity (const char *current_desktop)
 {
         gchar  **desktops;
         gboolean unity;
 
         if (current_desktop == NULL || *current_desktop == '\0')
-                return configured;
+                return FALSE;
 
         desktops = g_strsplit (current_desktop, ":", -1);
         unity = g_strv_contains ((const gchar * const *) desktops, "Unity");
         g_strfreev (desktops);
 
-        return unity ? 0 : configured;
+        return unity;
+}
+
+/* In a Unity session Unity asks for the blank and decides whether and when
+ * to lock, from the desktop's screensaver settings, so no lock timer of our
+ * own is armed.  The setting itself is left as it is. */
+guint
+gs_lock_after_for_desktop (guint       configured,
+                           const char *current_desktop)
+{
+        return gs_desktop_is_unity (current_desktop) ? 0 : configured;
 }
